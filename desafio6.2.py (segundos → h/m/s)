# Entrada do total de segundos
segundos = int(input("Digite o número de segundos: "))

# Cálculo das horas
horas = segundos // 3600

# Cálculo dos minutos
minutos = (segundos % 3600) // 60

# Cálculo dos segundos restantes
seg_restantes = segundos % 60

# Mostra o resultado
print(f"{horas}h {minutos}min {seg_restantes}s")
