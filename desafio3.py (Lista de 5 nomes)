# Cria uma lista vazia para armazenar nomes
nomes = []

# Repete 5 vezes para pedir 5 nomes
for i in range(5):
    # Recebe um nome digitado pelo usuário
    nome = input("Digite um nome: ")
    
    # Adiciona o nome dentro da lista
    nomes.append(nome)

# Mostra um título
print("Nomes digitados:")

# Percorre a lista e imprime cada nome
for nome in nomes:
    print(nome)
