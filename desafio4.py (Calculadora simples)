# Recebe o primeiro número
num1 = float(input("Primeiro número: "))

# Recebe o segundo número
num2 = float(input("Segundo número: "))

# Recebe a operação desejada (+, -, * ou /)
op = input("Operação (+ - * /): ")

# Verifica qual operação foi escolhida
if op == "+":
    print("Resultado:", num1 + num2)  # Soma
elif op == "-":
    print("Resultado:", num1 - num2)  # Subtração
elif op == "*":
    print("Resultado:", num1 * num2)  # Multiplicação
elif op == "/":
    # Verifica se o divisor é diferente de zero
    if num2 != 0:
        print("Resultado:", num1 / num2)  # Divisão
    else:
        print("Erro: divisão por zero")
else:
    # Caso o usuário digite algo inválido
    print("Operação inválida")
