# Recebe o valor do capital inicial
capital = float(input("Capital: "))

# Recebe a taxa de juros (em porcentagem)
taxa = float(input("Taxa (%): "))

# Recebe o tempo (período)
tempo = float(input("Tempo: "))

# Aplica a fórmula de juros simples
juros = (capital * taxa * tempo) / 100

# Mostra o valor dos juros calculados
print("Juros:", juros)
